[Desktop Entry]
Name=Tailscale
Comment=Aparelhos da rede Tailscale: copiar IP, SSH, ping
Type=Service
Icon=network-vpn
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Author=JacundaEntorpe
X-KDE-PluginInfo-Name=krocket-tailscale
X-KDE-PluginInfo-Version=1.1
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.jacunda.krocket
X-Plasma-DBusRunner-Path=/tailscale
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=2
X-Plasma-Runner-Syntaxes=ts :q:
X-Plasma-Runner-Syntax-Descriptions=Mostra o aparelho :q: da rede Tailscale; Enter copia o IP
