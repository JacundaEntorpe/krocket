[Desktop Entry]
Name=Hermes
Comment=Manda uma tarefa pro Hermes, o agente que mexe no PC
Type=Service
Icon=dialog-scripts
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Author=JacundaEntorpe
X-KDE-PluginInfo-Name=krocket-hermes
X-KDE-PluginInfo-Version=1.1
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.jacunda.krocket
X-Plasma-DBusRunner-Path=/hermes
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=2
X-Plasma-Runner-Syntaxes=hm :q:
X-Plasma-Runner-Syntax-Descriptions=Manda a tarefa :q: pro Hermes; Enter abre no terminal
