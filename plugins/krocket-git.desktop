[Desktop Entry]
Name=Git: o que falta commitar
Comment=Repositórios com alterações, commits sem push ou atrás do remote
Type=Service
Icon=vcs-locally-modified
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Author=JacundaEntorpe
X-KDE-PluginInfo-Name=krocket-git
X-KDE-PluginInfo-Version=1.1
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.jacunda.krocket
X-Plasma-DBusRunner-Path=/git
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=2
X-Plasma-Runner-Syntaxes=gs :q:
X-Plasma-Runner-Syntax-Descriptions=Mostra os repositórios com pendências; :q: filtra pelo nome
