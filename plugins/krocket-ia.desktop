[Desktop Entry]
Name=IA local
Comment=Pergunta pra IA local (Ollama) e mostra a resposta numa notificação
Type=Service
Icon=dialog-messages
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Author=JacundaEntorpe
X-KDE-PluginInfo-Name=krocket-ia
X-KDE-PluginInfo-Version=1.1
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.jacunda.krocket
X-Plasma-DBusRunner-Path=/ia
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=2
X-Plasma-Runner-Syntaxes=ia :q:
X-Plasma-Runner-Syntax-Descriptions=Pergunta :q: pra IA local; "ia liberar" tira o modelo da memória
