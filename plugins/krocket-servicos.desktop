[Desktop Entry]
Name=Serviços (systemd)
Comment=Status, logs, start, stop e restart de serviços do systemd
Type=Service
Icon=preferences-system-services
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Author=JacundaEntorpe
X-KDE-PluginInfo-Name=krocket-servicos
X-KDE-PluginInfo-Version=1.1
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.jacunda.krocket
X-Plasma-DBusRunner-Path=/servicos
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=2
X-Plasma-Runner-Syntaxes=sv :q:
X-Plasma-Runner-Syntax-Descriptions=Mostra o serviço do systemd :q:; sv sozinho lista os favoritos
