[Desktop Entry]
Name=Containers Docker
Comment=Logs, shell, start, stop e restart de containers Docker
Type=Service
Icon=docker
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Author=JacundaEntorpe
X-KDE-PluginInfo-Name=krocket-docker
X-KDE-PluginInfo-Version=1.0
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=org.jacunda.krocket
X-Plasma-DBusRunner-Path=/docker
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Min-Letter-Count=2
X-Plasma-Runner-Syntaxes=dk :q:
X-Plasma-Runner-Syntax-Descriptions=Lista os containers Docker cujo nome ou projeto compose bate com :q:
