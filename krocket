        ("ping", "Ping", "network-wired"),
    ]

    def __init__(self, bus, cfg):
        super().__init__(bus, cfg)
        self.cache, self.quando = {}, 0

    def aparelhos(self):
        if time.time() - self.quando < 10:
            return self.cache
        aparelhos = {}
        try:
            r = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True, timeout=3)
            d = json.loads(r.stdout)
            for p, eu in [(d["Self"], True)] + [(p, False) for p in (d.get("Peer") or {}).values()]:
                if not p.get("TailscaleIPs"):
                    continue
                aparelhos[p["TailscaleIPs"][0]] = {
                    "nome": p.get("HostName", "?"), "dns": p.get("DNSName", "").rstrip("."),
                    "so": p.get("OS", ""), "online": p.get("Online", False) or eu, "eu": eu,
                    "visto": p.get("LastSeen", ""),
                }
        except (OSError, subprocess.TimeoutExpired, ValueError, KeyError):
            pass
        self.cache, self.quando = aparelhos, time.time()
        return aparelhos

    def buscar(self, termo, com_palavra):
        termo = normalizar(termo)
        saida = []
        for ip, a in self.aparelhos().items():
            alvo = normalizar(f"{a['nome']} {a['dns']} {ip} {a['so']}")
            if termo and termo not in alvo:
                continue
            partes = [ip, a["so"], "este PC" if a["eu"] else ("online" if a["online"] else "offline"), a["dns"]]
            celular = a["so"] in ("android", "iOS")
            icone = ("smartphone" if celular else "computer") if a["online"] else "network-disconnect"
            acoes = ["dns", "navegador", "ping"] if celular else ["ssh", "dns", "navegador", "ping"]
            nota = (1.0 if normalizar(a["nome"]) == termo else 0.8) - (0 if a["online"] else 0.3)
            saida.append(resultado(ip, a["nome"], icone, ALTA, nota, "  ·  ".join(p for p in partes if p), acoes))
        saida.sort(key=lambda r: (-r[4], r[1].lower()))
        return saida

    def rodar(self, ip, acao):
        a = self.cache.get(ip, {})
        host = a.get("dns", "").split(".")[0] or ip
        term = self.cfg["terminal"]
        if acao == "ssh":
            usuario = self.cfg["usuarios"].get(a.get("nome", ""), "")
            no_terminal(term, ["ssh", f"{usuario}@{host}" if usuario else host])
        elif acao == "dns":
            copiar(a.get("dns") or ip)
        elif acao == "navegador":
            lancar(["xdg-open", f"http://{a.get('dns') or ip}"])
        elif acao == "ping":
            no_terminal(term, ["ping", "-c", "10", ip], segurar=True)
        else:  # Enter: copia o IP
            copiar(ip)


