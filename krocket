def esc(texto):
    return escapar(" ⏎ ".join(str(texto).split("\n")))


def escapar(texto):
    """Escapa texto pro markup do rofi (Pango)."""
    return (str(texto).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace("'", "&#39;").replace('"', "&quot;"))


def tema_icones(cfg):
    if cfg["icones"]:
        return cfg["icones"]
    for arquivo, padrao in ((Path.home() / ".config/kdeglobals", r"^\[Icons\]\s*\nTheme=(.+)$"),
                            (Path.home() / ".config/gtk-3.0/settings.ini", r"^gtk-icon-theme-name\s*=\s*(.+)$")):
        try:
            m = re.search(padrao, arquivo.read_text(errors="ignore"), re.M)
            if m:
                return m.group(1).strip()
        except OSError:
            pass
    return None


def tema_rofi(cfg):
    tema = Path(cfg["tema"]).expanduser()
    return str(tema if tema.exists() else AQUI / "menu" / "tema.rasi")


def rofi(cfg, entradas, prompt="krocket", mesg="", filtro="", linhas_max=None, dica=None, msg_em_cima=False,
         vistas=None):
    """Abre o rofi em modo dmenu. Devolve (mais_acoes, índice, texto digitado) ou None se fechou.
    entradas pode ser um gerador: o rofi abre na hora e as linhas entram conforme ficam prontas.
    Cada entrada escrita vai pra lista vistas (é ela que o índice devolvido referencia)."""
    cmd = ["rofi", "-dmenu", "-i", "-markup-rows", "-show-icons", "-format", "i f", "-p", prompt,
           "-async-pre-read", "0", "-sort", "-sorting-method", "fzf",  # o que bate melhor sobe
           "-matching", "prefix",  # cada palavra digitada casa com o começo de uma palavra (gs não pega "logs")
           "-theme", tema_rofi(cfg), "-kb-accept-alt", "", "-kb-custom-1", "Shift+Return",
           "-kb-move-front", "", "-kb-clear-line", "Control+a,Control+w",  # rofi não seleciona texto: Ctrl+A apaga tudo
           # Clique fora da caixa fecha; clique num item abre direto (o clique no item tem prioridade)
           "-kb-cancel", "Escape,Control+g,Control+bracketleft,MousePrimary,MouseSecondary",
           "-me-select-entry", "", "-me-accept-entry", "MousePrimary"]
    icones = tema_icones(cfg)
    if icones:
        cmd += ["-icon-theme", icones]
    if mesg:
        cmd += ["-mesg", mesg]
    if filtro:
        cmd += ["-filter", filtro]
    if linhas_max:  # janela do tamanho da lista, sem espaço vazio
        cmd += ["-l", str(min(linhas_max, 10))]
    if dica is not None:
        cmd += ["-theme-str", f'entry {{ placeholder: "{dica}"; }}']
    if msg_em_cima:  # a mensagem é o conteúdo (resposta da IA), não o rodapé
        cmd += ["-theme-str", "mainbox { children: [ inputbar, message, listview ]; } "
                              "textbox { text-color: @texto; font: inherit; }"]
    vistas = [] if vistas is None else vistas
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    try:
        for e in entradas:
            opcoes = []
            if e.get("icone"):
                opcoes += ["icon", e["icone"]]
            if e.get("meta"):
                opcoes += ["meta", e["meta"]]
            proc.stdin.write(e["texto"] + ("\0" + "\x1f".join(opcoes) if opcoes else "") + "\n")
            proc.stdin.flush()
            vistas.append(e)
        proc.stdin.close()
    except (BrokenPipeError, OSError):  # escolheu antes de tudo carregar
        try:
            proc.stdin.close()
        except OSError:
            pass
    finally:
        if hasattr(entradas, "close"):
            entradas.close()
    saida = proc.stdout.read()
    proc.wait()
    if proc.returncode not in (0, 10):
        return None
    indice, _, digitado = saida.rstrip("\n").partition(" ")
    return proc.returncode == 10, int(indice) if re.fullmatch(r"-?\d+", indice) else -1, digitado


class Menu:
    def __init__(self, cfg):
        self.cfg, self.mc = cfg, cfg["menu"]
        self.plugins = montar(None, cfg)
        for p in self.plugins:
            p.LIMITE = 500  # no menu cabe tudo, o rofi filtra
        self.por_tipo = {type(p).__name__: p for p in self.plugins}

    @staticmethod
    def palavras(texto):
        """'PokeCroc_Server' -> 'pokecroc_server poke croc server': a busca do rofi é por
        início de palavra, e _ - . e CamelCase não separam palavras pra ele."""
        texto = str(texto)
        partes = re.sub(r"([a-z])([A-Z])", r"\1 \2", texto)
        partes = re.sub(r"[_\-./+]+", " ", partes)
        return normalizar(f"{texto} {partes}")

    def linha(self, palavra, texto, sub):
        t = f"<span foreground='{self.mc['cor_palavra']}' font_weight='bold'>{esc(palavra)}</span>  {esc(texto)}"
        if sub:
            t += f"    <span alpha='55%' size='small'>{esc(sub)}</span>"
        return t

    def entradas_de(self, p, resultados):
        palavra = p.cfg["palavra"]
        for id_, texto, icone, _rel, _nota, props in resultados:
            sub = str(props.get("subtext", ""))
            yield {
                "texto": self.linha(palavra, texto, sub if p.DESCRICAO_NA_LINHA else ""), "icone": icone,
                "plugin": p, "id": str(id_), "nome": str(texto),
                "acoes": [str(a) for a in props["actions"]] if "actions" in props else None,
                "meta": f"{palavra} {self.palavras(texto)} {self.palavras(sub)} {self.palavras(props.get('busca', ''))}",
            }

    def coletar(self):
        """Tudo o que aparece no menu, na ordem: cada plugin roda em paralelo e as linhas
        saem assim que o plugin da vez termina (os repositórios ficam prontos na hora)."""
        # Janelas e pastas por último: no menu recém-aberto ficam fora da vista, só sobem quando batem com o digitado
        ordem = ["Repos", "Apps", "Git", "Docker", "Servicos", "Tailscale", "IA", "Hermes", "Arquivos", "Janelas", "Pastas"]
        ex = ThreadPoolExecutor(len(ordem))
        try:
            futuros = [(self.por_tipo[t], ex.submit(self.por_tipo[t].Match, self.por_tipo[t].cfg["palavra"])) for t in ordem]
            for p, futuro in futuros:
                yield from self.entradas_de(p, futuro.result())
            ajuda = self.por_tipo["Ajuda"]
            for nome, texto, desc, icone, origem, _ in ajuda.itens():
                if origem == "do KDE" and not texto.endswith(":"):
                    continue  # calculadora, kill... são do KRunner, não existem no rofi
                yield {"texto": self.linha(ajuda.cfg["palavra"], nome, desc), "icone": icone,
                       "plugin": ajuda, "id": texto, "nome": nome,
                       "meta": f"{ajuda.cfg['palavra']} ajuda {normalizar(nome)} {normalizar(desc)}"}
        finally:
            ex.shutdown(wait=False, cancel_futures=True)

    def escolher_acao(self, e):
        p = e["plugin"]
        acoes = [a for a in p.ACOES if e["acoes"] is None or a[0] in e["acoes"]]
        if p.ACAO_PADRAO:
            acoes = [("", p.ACAO_PADRAO, e["icone"])] + acoes
        opcoes = [{"texto": esc(nome) + ("    <span alpha='55%' size='small'>Enter</span>" if not id_ else ""),
                   "icone": icone} for id_, nome, icone in acoes]
        r = rofi(self.mc, opcoes, prompt=e["nome"][:40], linhas_max=len(opcoes), dica="o que fazer?")
        if not r or not 0 <= r[1] < len(acoes):
            return None
        return acoes[r[1]][0]

    def perguntar_ia(self, pergunta):
        ia = self.por_tipo["IA"]
        espera = subprocess.Popen(["rofi", "-theme", tema_rofi(self.mc), "-kb-cancel", "Escape,MousePrimary", "-e",
                                   f"Perguntando pro {ia.cfg['modelo']}...\n\n{pergunta}"])
        resposta = ia.perguntar(pergunta, notificar=False)
        espera.terminate()
        if resposta is None:
            return None
        opcoes = [{"texto": "Copiar a resposta", "icone": "edit-copy"},
                  {"texto": "Continuar no Open WebUI", "icone": "internet-web-browser"},
                  {"texto": "Perguntar outra coisa", "icone": "dialog-messages"}]
        copiado = "  <span alpha='55%' size='small'>(já copiada)</span>" if ia.cfg["copiar_resposta"] else ""
        r = rofi(self.mc, opcoes, prompt="ia", mesg=f"<b>{esc(pergunta)}</b>\n\n{escapar(resposta)}{copiado}",
                 linhas_max=len(opcoes), dica="", msg_em_cima=True)
        if not r or r[1] < 0:
            return None
        if r[1] == 0:
            copiar(resposta, aviso=False)
        elif r[1] == 1:
            ia.rodar(pergunta, "webui")
        else:
            return ia.cfg["palavra"] + " "
        return None

    def executar(self, e, mais_acoes, digitado):
        """Roda a entrada escolhida. Devolve um texto pra reabrir o menu filtrado, ou None pra fechar."""
        p = e["plugin"]
        if isinstance(p, Ajuda):
            return e["id"]
        if not e["id"]:  # dica ("Pergunte algo..."): reabre com a palavra-chave digitada
            return p.cfg["palavra"] + " "
        acao = ""
        if mais_acoes:
            acao = self.escolher_acao(e)
            if acao is None:
                return digitado
        if isinstance(p, IA) and not acao and e["id"] != "@liberar" and e["id"] not in p.respostas:
            return self.perguntar_ia(e["id"])
        p.rodar(e["id"], acao)
        return None

    def mostrar_conta(self, conta, valor):
        copiar(valor.replace(" ", ""), aviso=False)
        opcoes = [{"texto": "Copiar o resultado", "icone": "edit-copy"},
                  {"texto": "Fazer outra conta", "icone": "accessories-calculator"}]
        r = rofi(self.mc, opcoes, prompt="=", linhas_max=2, dica="", msg_em_cima=True,
                 mesg=f"{esc(conta.lstrip('='))} =\n<span size='xx-large' font_weight='bold'>{esc(valor)}</span>"
                      "  <span alpha='55%' size='small'>(já copiado)</span>")
        if r and r[1] == 1:
            return "="
        return None

    def texto_livre(self, texto):
        """Enter num texto que não bate com nada: ia/hm com pergunta, atalho web ou busca."""
        texto = texto.strip()
        if not texto:
            return None
        for tipo in ("IA", "Hermes"):
            p = self.por_tipo[tipo]
            com, termo = p.separar(texto)
            if com and termo:
                if tipo == "IA":
                    return self.perguntar_ia(termo)
                p.rodar(termo, "")
                return None
        if (valor := calcular(texto)) is not None:
            return self.mostrar_conta(texto, valor)
        m = re.match(r"^([\w.-]+):(.*)$", texto)
        if m and (url := url_atalho(m.group(1), m.group(2).strip())):
            lancar(["xdg-open", url])
            return None
        for p in self.plugins:  # "sv xyz": o menu só tem os favoritos; busca em tudo do plugin
            if p.separar(texto)[0]:
                achados, resultados = [], p.Match(texto)
                r = rofi(self.mc, self.entradas_de(p, resultados), prompt=texto, vistas=achados,
                         mesg=RODAPE) if resultados else None
                if r is None:
                    if not achados:
                        avisar("Nada encontrado", texto, "edit-find")
                    return None if achados else texto
                mais_acoes, indice, digitado = r
                return self.executar(achados[indice], mais_acoes, digitado) if 0 <= indice < len(achados) else None
        m = re.match(r"^([\w.-]+)\s+(.+)$", texto)  # "protondb elden ring" vale igual a "protondb:elden ring"
        if m and (url := url_atalho(m.group(1).lower(), m.group(2))):
            lancar(["xdg-open", url])
            return None
        lancar(["xdg-open", self.mc["busca"].format(quote(texto))])
        return None

    def rodar(self, filtro=""):
        vigia = VigiaFoco()
        vigia.ligar()
        try:
            self.laco(filtro)
        finally:
            vigia.desligar()
        for t in threading.enumerate():  # espera docker/git/IA terminarem antes de sair
            if t is not threading.main_thread() and t.name != "hyprland":
                t.join()

    def laco(self, filtro):
        while True:
            entradas = []
            r = rofi(self.mc, self.coletar(), mesg=RODAPE, filtro=filtro, vistas=entradas)
            if r is None:
                break
            mais_acoes, indice, digitado = r
            if 0 <= indice < len(entradas):
                filtro = self.executar(entradas[indice], mais_acoes, digitado)
            else:
                filtro = self.texto_livre(digitado)
            if filtro is None:
                break


def fechar_rofi(idade_minima=0.4):
    """Fecha os rofi abertos há mais de idade_minima segundos. O menu que acabou de abrir
    (um submenu, por exemplo) fica: ele é mais novo que isso."""
    try:
        agora = float(Path("/proc/uptime").read_text().split()[0])
        por_seg = os.sysconf("SC_CLK_TCK")
        pids = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "rofi"],
                              capture_output=True, text=True).stdout.split()
    except OSError:
        return
    for pid in pids:
        try:
            inicio = int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]) / por_seg
            if agora - inicio > idade_minima:
                os.kill(int(pid), 15)
        except (OSError, ValueError, IndexError):
            pass


def menu_aberto():
    """True se outro "krocket menu" está com o rofi aberto agora."""
    r = subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", r"krocket menu( |$)"], capture_output=True, text=True)
    outros = [p for p in r.stdout.split() if int(p) != os.getpid()]
    if not outros:
        return False
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "rofi"], capture_output=True).returncode == 0


class FocoMenu(dbus.service.Object):
    """/menu no serviço D-Bus: o script do KWin chama Fechar quando o menu perde o foco."""

    def __init__(self, bus):
        super().__init__(bus, "/menu")

    @dbus.service.method("org.jacunda.krocket.Menu")
    def Fechar(self):
        fechar_rofi()


class VigiaFoco:
    """Fecha o menu quando outra janela ganha o foco. No KDE usa um script do KWin;
    no Hyprland escuta os eventos dele. Nos outros desktops não faz nada."""
    NOME_KWIN = "krocket-foco"

    def __init__(self):
        self.kwin = None
        self.hypr = None

    def ligar(self):
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            threading.Thread(target=self.ouvir_hyprland, name="hyprland", daemon=True).start()
            return
        try:
            bus = dbus.SessionBus()
            scripting = bus.get_object("org.kde.KWin", "/Scripting")
            iface = dbus.Interface(scripting, "org.kde.kwin.Scripting")
            if iface.isScriptLoaded(self.NOME_KWIN):
                return  # sobrou de um menu anterior: já está valendo
            id_ = iface.loadScript(str(AQUI / "menu" / "foco-kwin.js"), self.NOME_KWIN, signature="ss")
            if id_ >= 0:
                bus.get_object("org.kde.KWin", f"/Scripting/Script{id_}").run(dbus_interface="org.kde.kwin.Script")
                self.kwin = iface
        except Exception as e:  # não é KDE, ou o KWin mudou: o menu funciona igual, só sem a vigia
            print(f"krocket: sem fechar ao perder o foco ({e!r})", file=sys.stderr)

    def ouvir_hyprland(self):
        import socket
        caminho = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "hypr" / \
            os.environ["HYPRLAND_INSTANCE_SIGNATURE"] / ".socket2.sock"
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.connect(str(caminho))
                self.hypr = s
                for linha in s.makefile(errors="ignore"):
                    if linha.startswith("activewindow>>"):
                        fechar_rofi()
        except OSError:
            pass

    def desligar(self):
        if self.kwin:
            try:
                self.kwin.unloadScript(self.NOME_KWIN)
            except dbus.DBusException:
                pass
        if self.hypr:
            try:
                self.hypr.shutdown(2)
            except OSError:
                pass


def url_atalho(chave, termo):
    """URL de um atalho de busca (aur:, gg:...) a partir dos .desktop do KDE ou do krocket."""
    for pasta in (DADOS / "kf6/searchproviders", Path("/usr/share/kf6/searchproviders"), AQUI / "atalhos-web"):
        for f in pasta.glob("*.desktop") if pasta.is_dir() else []:
            texto = f.read_text(errors="ignore")
            chaves = re.search(r"^Keys=(.*)$", texto, re.M)
            consulta = re.search(r"^Query=(.*)$", texto, re.M)
            if chaves and consulta and chave in chaves.group(1).split(","):
                usuario = subprocess.run(["git", "config", "--global", "user.name"], capture_output=True,
                                         text=True).stdout.strip() or os.environ.get("USER", "")
                return re.sub(r"\\+\{@\}", quote(termo), consulta.group(1)).replace("@GITHUB_USER@", usuario)
    return None


def tecla_atual():
    """Tecla do menu no KDE ("Meta+Space"), ou None se não tiver."""
    nomes = {0x20: "Space", 0x01000004: "Return", 0x01000001: "Tab", 0x01000000: "Escape", 0x01000009: "Print"}
    try:
        ka = dbus.SessionBus().get_object("org.kde.kglobalaccel", "/kglobalaccel")
        teclas = ka.shortcutKeys(dbus.Array(["krocket.desktop", "_launch", "krocket", "krocket"], signature="s"),
                                 dbus_interface="org.kde.KGlobalAccel")
    except dbus.DBusException:
        return None
    codigo = next((int(t[0][0]) for t in teclas if t[0] and t[0][0]), 0)
    if not codigo:
        return None
    partes = [n for bit, n in ((0x10000000, "Meta"), (0x04000000, "Ctrl"), (0x08000000, "Alt"), (0x02000000, "Shift"))
              if codigo & bit]
    base = codigo & 0x01FFFFFF
    partes.append(nomes.get(base) or (f"F{base - 0x01000030 + 1}" if 0x01000030 <= base <= 0x0100003B else chr(base)))
    return "+".join(partes)


def ligar_atalho(tecla):
    """Liga o menu a uma tecla no KDE, valendo na hora (sem sair da sessão)."""
    mods = {"meta": 0x10000000, "super": 0x10000000, "ctrl": 0x04000000, "control": 0x04000000,
            "alt": 0x08000000, "shift": 0x02000000}
    especiais = {"space": 0x20, "espaco": 0x20, "return": 0x01000004, "enter": 0x01000004,
                 "tab": 0x01000001, "escape": 0x01000000, "print": 0x01000009}
    codigo = 0
    for parte in tecla.split("+"):
        nome = normalizar(parte.strip())
        if nome in mods:
            codigo |= mods[nome]
        elif nome in especiais:
            codigo |= especiais[nome]
        elif re.fullmatch(r"f([1-9]|1[0-2])", nome):
            codigo |= 0x01000030 + int(nome[1:]) - 1
        elif len(nome) == 1:
            codigo |= ord(nome.upper())
        else:
            sys.exit(f"Não entendi a tecla \"{parte}\". Exemplos: Meta+Space, Ctrl+Alt+K, Meta+F1")
    ka = dbus.SessionBus().get_object("org.kde.kglobalaccel", "/kglobalaccel")
    sequencia = dbus.Struct([dbus.Array([codigo, 0, 0, 0], signature="i")])
    # O KDE recusa calado uma tecla que já é de outro atalho (Alt+Espaço é do KRunner, por exemplo)
    donos = [str(d[3] or d[2]) for d in ka.globalShortcutsByKey(sequencia, dbus.Struct([dbus.Int32(0)]),
                                                                dbus_interface="org.kde.KGlobalAccel")
             if str(d[2]) != "krocket.desktop"]
    if donos:
        sys.exit(f"{tecla} já é de {', '.join(donos)}. Tire de lá em Configurações do Sistema → Atalhos "
                 f"e rode \"krocket atalho {tecla}\" de novo, ou escolha outra tecla.")
    acao = dbus.Array(["krocket.desktop", "_launch", "krocket", "krocket"], signature="s")
    ka.doRegister(acao, dbus_interface="org.kde.KGlobalAccel")
    # SetPresent (2) marca o atalho como ativo: sem isso o KDE guarda a tecla mas não escuta.
    # NoAutoloading (4) faz valer a tecla passada, e não a que estiver salva.
    ficou = ka.setShortcutKeys(acao, dbus.Array([sequencia], signature="(ai)"), dbus.UInt32(2 | 4),
                               dbus_interface="org.kde.KGlobalAccel")
    if not any(s[0] and s[0][0] == codigo for s in ficou):
        sys.exit(f"O KDE não aceitou {tecla}. Ligue em Configurações do Sistema → Atalhos → procure \"krocket\".")
    comp = dbus.SessionBus().get_object("org.kde.kglobalaccel", "/component/krocket_desktop")
    if not comp.isActive(dbus_interface="org.kde.kglobalaccel.Component"):
        sys.exit("O KDE registrou a tecla mas não ativou. Ligue em Configurações do Sistema → Atalhos.")
    print(f"krocket menu ligado a {tecla}.")


def main():
    if sys.argv[1:2] == ["reiniciar"]:
        # Mata o serviço (o D-Bus sobe de novo na próxima busca) e reinicia o KRunner pra ele
        # reler os plugins. Só fechar o KRunner não serve: o Alt+Espaço não consegue abrir ele de volta.
        subprocess.run(["pkill", "-f", "python3? .*krocket$"], check=False)
        subprocess.run(["systemctl", "--user", "restart", "plasma-krunner"], capture_output=True, check=False)
        return
    if sys.argv[1:2] == ["atalho"] and len(sys.argv) == 3:  # krocket atalho Meta+Space (só no KDE)
        ligar_atalho(sys.argv[2])
        return
    if sys.argv[1:] == ["atalho"]:  # mostra a tecla atual; sai com erro se não tiver
        atual = tecla_atual()
        print(atual or "O menu não tem tecla. Ligue com: krocket atalho Meta+Space")
        sys.exit(0 if atual else 1)
    if sys.argv[1:2] == ["menu"]:
        if not shutil.which("rofi"):
            sys.exit("krocket menu precisa do rofi: sudo pacman -S rofi")
        if menu_aberto():  # apertou o atalho com o menu aberto: fecha em vez de abrir outro
            fechar_rofi(idade_minima=0)
            return
        Menu(carregar_config()).rodar(" ".join(sys.argv[2:]))
        return
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    cfg = carregar_config()
    if "--testar" in sys.argv:  # krocket --testar "vs poke": mostra o que o KRunner receberia
        q = " ".join(a for a in sys.argv[1:] if a != "--testar")
        for plugin in montar(bus, cfg):
            for r in plugin.Match(q):
                print(f"[{type(plugin).__name__}] {r[1][:50]:<50} {r[4]:.2f}  {r[5]['subtext']}")
        return
    nome = dbus.service.BusName(SERVICO, bus, do_not_queue=True)  # noqa: F841 (segura o nome no bus)
    montar(bus, cfg)
    FocoMenu(bus)
    from gi.repository import GLib
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
