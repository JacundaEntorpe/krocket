    def janelas(self):
        """[(id, título, ícone)]"""
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            try:
                clientes = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                                     text=True, timeout=2).stdout)
            except (OSError, ValueError, subprocess.TimeoutExpired):
                return []
            return [(c["address"], c["title"] or c["class"], c["class"].lower() or self.ICONE)
                    for c in clientes if c.get("mapped", True) and (c["title"] or c["class"])]
        try:
            matches = runner_kde("org.kde.KWin", "/WindowsRunner").Match("")
        except dbus.DBusException:
            return []
        vistas, saida = set(), []
        for id_, titulo, icone, *_ in matches:
            # "0_..." são janelas (vêm repetidas); o resto são áreas de trabalho
            if str(id_).startswith("0_") and id_ not in vistas:
                vistas.add(id_)
                saida.append((str(id_), str(titulo), str(icone) or self.icone_do_titulo(str(titulo))))
        return saida

    def icone_do_titulo(self, titulo):
        """O KWin não manda o ícone de alguns apps; "Amigos - Discord" vira o ícone "discord"."""
        nome = re.split(r" [-—–] ", titulo)[-1].strip().lower().replace(" ", "-")
        for padrao in (f"/usr/share/icons/hicolor/*/apps/{nome}.*", f"/usr/share/pixmaps/{nome}.*",
                       str(DADOS / f"icons/hicolor/*/apps/{nome}.*"), f"/var/lib/flatpak/exports/share/icons/hicolor/*/apps/*{nome}*"):
            if nome and glob.glob(padrao):
                return nome if "flatpak" not in padrao else Path(glob.glob(padrao)[0]).stem
        return self.ICONE

    def buscar(self, termo, com_palavra):
        termo = normalizar(termo)
        return [resultado(id_, titulo, icone, ALTA, 0.5, "janela aberta")
                for id_, titulo, icone in self.janelas() if not termo or termo in normalizar(titulo)]

    def rodar(self, id_, acao):
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            lancar(["hyprctl", "dispatch", "focuswindow", f"address:{id_}"])
            return
        try:
            runner_kde("org.kde.KWin", "/WindowsRunner").Run(id_, "")
        except dbus.DBusException as e:
            avisar("Não deu pra ir pra janela", str(e), "dialog-error")


