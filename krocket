        ("fundo", "Rodar em segundo plano (resposta numa notificação)", "system-run"),
        ("copiar", "Copiar a resposta", "edit-copy"),
    ]

    def __init__(self, bus, cfg):
        super().__init__(bus, cfg)
        self.respostas, self.rodando = {}, set()

    def buscar(self, termo, com_palavra):
        if not shutil.which(self.cfg["comando"]):
            return [resultado("", "Hermes não está instalado", "dialog-warning", ALTA, 1.0,
                              "Veja ~/dotfiles/ia/LEIA-ME.md")]
        if not termo:
            return [resultado("", "Mande uma tarefa pro Hermes", self.ICONE, ALTA, 1.0,
                              "hm <tarefa>  ·  ex.: hm organiza minha pasta Downloads por tipo")]
        if termo in self.respostas:
            return [resultado(termo, self.respostas[termo], self.ICONE, ALTA, 1.0,
                              "Resposta do Hermes  ·  Enter copia", ["copiar"], multilinha=True)]
        if termo in self.rodando:
            return [resultado("", "O Hermes está trabalhando nisso...", "chronometer", ALTA, 1.0,
                              "A resposta chega numa notificação")]
        return [resultado(termo, f"Hermes: {termo}", self.ICONE, ALTA, 1.0,
                          "Enter abre no terminal (dá pra acompanhar e aprovar)  ·  ou rode em segundo plano",
                          ["fundo"])]

    def em_segundo_plano(self, tarefa):
        self.rodando.add(tarefa)
        id_ = avisar("Hermes trabalhando...", tarefa, "chronometer")
        try:
            r = subprocess.run([self.cfg["comando"], "-z", tarefa], capture_output=True, text=True,
                               timeout=900, stdin=subprocess.DEVNULL)
            resposta = (r.stdout.strip() or r.stderr.strip())[-2000:]
            ok = r.returncode == 0
        except subprocess.TimeoutExpired:
            resposta, ok = "Passou de 15 minutos, desisti de esperar.", False
        finally:
            self.rodando.discard(tarefa)
        self.respostas[tarefa] = resposta
        avisar("Hermes terminou" if ok else "Hermes deu erro", resposta[-600:],
               "dialog-scripts" if ok else "dialog-error", substituir=id_)

    def rodar(self, tarefa, acao):
        if acao == "fundo":
            threading.Thread(target=self.em_segundo_plano, args=(tarefa,), daemon=True).start()
        elif acao == "copiar" or tarefa in self.respostas:
            copiar(self.respostas.get(tarefa, ""))
        else:
            no_terminal(self.cfg["terminal"], [self.cfg["comando"], "chat", "-q", tarefa])


