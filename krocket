# ---------------------------------------------------------------- calculadora (só no menu)

def calcular(texto):
    """Resolve contas simples ("2^10*3", "=15% de 80", "sqrt(2)"). None se não for conta."""
    import ast
    import math
    t = texto.strip().lstrip("=").strip().lower()
    t = re.sub(r"(\d+(?:[.,]\d+)?)\s*% de\s*", r"\1/100*", t)
    t = t.replace("^", "**").replace("×", "*").replace("÷", "/").replace(",", ".")
    if not t or not re.search(r"\d", t) or not re.fullmatch(r"[\d\s.+\-*/()%a-z_]+", t):
        return None
    funcoes = {n: getattr(math, n) for n in ("sqrt", "sin", "cos", "tan", "log", "log10", "log2", "exp", "floor", "ceil")}
    funcoes.update(pi=math.pi, e=math.e, abs=abs, round=round)
    ops = (ast.Expression, ast.BinOp, ast.UnaryOp, ast.Constant, ast.Call, ast.Name, ast.Load,
           ast.Add, ast.Sub, ast.Mult, ast.Div, ast.FloorDiv, ast.Mod, ast.Pow, ast.USub, ast.UAdd)
    try:
        arvore = ast.parse(t, mode="eval")
        if not all(isinstance(n, ops) for n in ast.walk(arvore)):
            return None
        if any(isinstance(n, ast.Name) and n.id not in funcoes for n in ast.walk(arvore)):
            return None
        if not any(isinstance(n, (ast.BinOp, ast.UnaryOp, ast.Call)) for n in ast.walk(arvore)):
            return None  # um número sozinho não é conta
        valor = eval(compile(arvore, "<conta>", "eval"), {"__builtins__": {}}, funcoes)
    except Exception:
        return None
    if isinstance(valor, float):
        valor = int(valor) if valor.is_integer() and abs(valor) < 1e15 else round(valor, 10)
    return f"{valor:,}".replace(",", " ") if isinstance(valor, int) and abs(valor) >= 10000 else str(valor)


