CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "krocket"


def pastas_apps():
    dados = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    pastas = [DADOS, Path.home() / ".local/share/flatpak/exports/share", Path("/var/lib/flatpak/exports/share")]
    pastas += [Path(d) for d in dados.split(":") if d]
    vistas, saida = set(), []
    for p in pastas:
        p = p / "applications"
        if p.is_dir() and p.resolve() not in vistas:
            vistas.add(p.resolve())
            saida.append(p)
    return saida


def ler_desktop(caminho, idiomas, desktops):
    """Campos de um .desktop de app, ou None se ele não deve aparecer."""
    campos, grupo = {}, None
    for linha in caminho.read_text(errors="ignore").splitlines():
        linha = linha.strip()
        if linha.startswith("["):
            grupo = linha
            continue
        if grupo != "[Desktop Entry]" or "=" not in linha:
            continue
        chave, valor = linha.split("=", 1)
        campos[chave.strip()] = valor.strip()
    if campos.get("Type") != "Application" or campos.get("NoDisplay") == "true" or campos.get("Hidden") == "true":
        return None
    so = [d for d in campos.get("OnlyShowIn", "").split(";") if d]
    nao = [d for d in campos.get("NotShowIn", "").split(";") if d]
    if (so and not desktops & set(so)) or (desktops & set(nao)):
        return None

    def local(chave):
        for idioma in idiomas:
            if f"{chave}[{idioma}]" in campos:
                return campos[f"{chave}[{idioma}]"]
        return campos.get(chave, "")
    if not local("Name"):
        return None
    return {"nome": local("Name"), "generico": local("GenericName"), "comentario": local("Comment"),
            "palavras": local("Keywords").replace(";", " "), "icone": campos.get("Icon", "application-x-executable"),
            "exec": Path(shlex.split(campos.get("Exec", "x") or "x")[0]).name if campos.get("Exec") else ""}


class Apps(Plugin):
    """Os apps instalados (os mesmos do menu do desktop). Abre com gio/gtk-launch/dex,
    então funciona em qualquer desktop. Os mais usados sobem na lista."""
    CAMINHO = "/apps"
    ID = "krocket-apps"
    DESCRICAO = "Apps instalados"
    ICONE = "applications-all"
    ACAO_PADRAO = "Abrir"
    LIMITE = 500
    # "Internet Messenger", "Monitor de sistema"... só atrapalham a ordem (o rofi pontua a linha
    # inteira); continuam valendo pra busca
    DESCRICAO_NA_LINHA = False
    ACOES = [("pasta", "Mostrar o arquivo .desktop", "document-open-folder")]
    USO = CACHE / "uso-apps.json"

    def __init__(self, bus, cfg):
        super().__init__(bus, cfg)
        try:
            self.uso = json.loads(self.USO.read_text())
        except (OSError, ValueError):
            self.uso = {}

    def apps(self):
        lang = os.environ.get("LANG", "en_US.UTF-8").split(".")[0]
        idiomas = [lang, lang.split("_")[0]]
        desktops = set(os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")) - {""}
        achados = {}
        for pasta in pastas_apps():
            for f in sorted(pasta.rglob("*.desktop")):
                id_ = str(f.relative_to(pasta)).replace("/", "-")
                if id_ in achados or id_ == "krocket.desktop":  # o da home ganha do sistema; o krocket não lista a si mesmo
                    continue
                try:
                    achados[id_] = (f, ler_desktop(f, idiomas, desktops))
                except OSError:
                    continue
        return {i: (f, a) for i, (f, a) in achados.items() if a}

    def buscar(self, termo, com_palavra):
        termo = normalizar(termo)
        saida = []
        for id_, (f, a) in self.apps().items():
            alvo = normalizar(f"{a['nome']} {a['generico']} {a['palavras']} {a['exec']}")
            if termo and termo not in alvo:
                continue
            sub = "  ·  ".join(x for x in (a["generico"], a["comentario"]) if x and x != a["nome"])
            nota = min(1.0, 0.5 + self.uso.get(id_, 0) * 0.02)
            r = resultado(str(f), a["nome"], a["icone"], ALTA, nota, sub)
            r[5]["busca"] = f"{a['generico']} {a['palavras']} {a['exec']}"  # só pro filtro do menu
            saida.append(r)
        saida.sort(key=lambda r: (-r[4], r[1].lower()))
        return saida[:self.LIMITE]

    def rodar(self, arquivo, acao):
        if acao == "pasta":
            lancar(["xdg-open", str(Path(arquivo).parent)])
            return
        for cmd in (["gio", "launch", arquivo], ["gtk-launch", Path(arquivo).name], ["dex", arquivo]):
            if shutil.which(cmd[0]):
                lancar(cmd)
                break
        id_ = next((i for i, (f, _) in self.apps().items() if str(f) == arquivo), Path(arquivo).name)
        self.uso[id_] = self.uso.get(id_, 0) + 1
        try:
            CACHE.mkdir(parents=True, exist_ok=True)
            self.USO.write_text(json.dumps(self.uso))
        except OSError:
            pass


