class Servicos(Plugin):
    CAMINHO = "/servicos"
    ID = "krocket-servicos"
    DESCRICAO = "Serviços do systemd: status, logs, start/stop/restart"
    ICONE = "preferences-system-services"
    ACOES = [
        ("logs", "Ver os logs ao vivo", "view-list-text"),
        ("restart", "Reiniciar", "view-refresh"),
        ("stop", "Parar", "media-playback-stop"),
        ("start", "Iniciar", "media-playback-start"),
    ]

    def __init__(self, bus, cfg):
        super().__init__(bus, cfg)
        self.cache, self.quando = {}, 0

    @staticmethod
    def listar(usuario):
        base = ["systemctl"] + (["--user"] if usuario else [])
        unidades = {}
        try:
            r = subprocess.run(base + ["list-unit-files", "--type=service,timer", "-o", "json"],
                               capture_output=True, text=True, timeout=3)
            for u in json.loads(r.stdout or "[]"):
                if "@" not in u["unit_file"]:  # templates (foo@.service) não dá pra iniciar direto
                    unidades[u["unit_file"]] = {"habilitado": u["state"], "ativo": "inactive", "sub": "dead", "desc": ""}
            r = subprocess.run(base + ["list-units", "--type=service,timer", "--all", "-o", "json"],
                               capture_output=True, text=True, timeout=3)
            for u in json.loads(r.stdout or "[]"):
                if u["load"] == "not-found":
                    continue
                d = unidades.setdefault(u["unit"], {"habilitado": "", "ativo": "", "sub": "", "desc": ""})
                d.update(ativo=u["active"], sub=u["sub"], desc=u["description"])
        except (OSError, subprocess.TimeoutExpired, ValueError, KeyError):
            pass
        return unidades

    def unidades(self):
        if time.time() - self.quando > 5:
            todas = {}
            for usuario in (False, True):
                for nome, d in self.listar(usuario).items():
                    d["usuario"] = usuario
                    todas[("user:" if usuario else "system:") + nome] = d
            self.cache, self.quando = todas, time.time()
        return self.cache

    def buscar(self, termo, com_palavra):
        termo = normalizar(termo)
        favoritos = [normalizar(f) for f in self.cfg["favoritos"]]
        achados = []
        for id_, d in self.unidades().items():
            unidade = id_.split(":", 1)[1]
            base = normalizar(unidade.rsplit(".", 1)[0])
            fav = base in favoritos
            if termo:
                if base == termo:
                    nota = 1.0
                elif base.startswith(termo):
                    nota = 0.8
                elif termo in base or termo in normalizar(d["desc"]):
                    nota = 0.6
                else:
                    continue
                nota += 0.1 if fav else 0
            elif fav:
                nota = 1 - favoritos.index(base) * 0.01
            else:
                continue
            achados.append((nota, id_, unidade, d))
        achados.sort(key=lambda a: -a[0])
        saida = []
        for nota, id_, unidade, d in achados[:12]:
            ativo = d["ativo"] == "active"
            estado = f"{d['ativo']} ({d['sub']})" if d["sub"] else d["ativo"]
            partes = [estado, d["habilitado"], "usuário" if d["usuario"] else "sistema", d["desc"]]
            acoes = ["logs", "restart", "stop"] if ativo else ["start", "logs"]
            if d["ativo"] == "failed":
                icone = "dialog-error"
            else:
                icone = "media-playback-start" if ativo else "media-playback-stopped"
            saida.append(resultado(id_, unidade, icone, ALTA, min(nota, 1.0),
                                   "  ·  ".join(p for p in partes if p), acoes))
        return saida

    def rodar(self, id_, acao):
        escopo, unidade = id_.split(":", 1)
        usuario = escopo == "user"
        base = ["systemctl"] + (["--user"] if usuario else [])
        term = self.cfg["terminal"]
        if acao == "logs":
            no_terminal(term, ["journalctl", "--user-unit" if usuario else "-u", unidade, "-f", "-n", "200"])
        elif acao in ("start", "stop", "restart"):
            def rodar():
                # serviço do sistema: o polkit do KDE pede a senha numa janela
                r = subprocess.run(base + [acao, unidade], capture_output=True, text=True)
                if r.returncode == 0:
                    avisar(f"{unidade}: {acao} ok", "", "preferences-system-services")
                else:
                    avisar(f"{unidade}: {acao} falhou", r.stderr.strip()[:300], "dialog-error")
                self.quando = 0
            threading.Thread(target=rodar, daemon=True).start()
        else:  # Enter: status completo (com as últimas linhas do log)
            no_terminal(term, base + ["status", "--no-pager", "-n", "30", unidade], segurar=True)

    def fechou(self):
        self.quando = 0


