def carregar_config():
    cfg = json.loads(json.dumps(PADRAO))
    try:
        with open(CONFIG, "rb") as f:
            usuario = tomllib.load(f)
    except FileNotFoundError:
        return cfg
    except tomllib.TOMLDecodeError as e:
        print(f"krocket: config inválida ({e}), usando o padrão", file=sys.stderr)
        return cfg
    for secao, valores in usuario.items():
        if isinstance(valores, dict) and secao in cfg:
            cfg[secao].update(valores)
    return cfg


def normalizar(s):
    s = unicodedata.normalize("NFKD", s.lower())
    return "".join(c for c in s if not unicodedata.combining(c))


def til(p):
    casa = str(Path.home())
    return "~" + p[len(casa):] if p.startswith(casa) else p


def lancar(cmd, cwd=None, env=None):
    subprocess.Popen(cmd, cwd=cwd, env=env, start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def no_terminal(terminal, args, cwd=None, segurar=False):
    """Roda args num terminal novo. segurar=True deixa a janela aberta quando o comando termina."""
    term = shlex.split(terminal)
    if "konsole" in term[0]:
        extra = (["--workdir", cwd] if cwd else []) + (["--hold"] if segurar else [])
        lancar(term + extra + (["-e"] + args if args else []), cwd=cwd)
    else:
        lancar(term + (["-e"] + args if args else []), cwd=cwd)


def avisar(titulo, texto="", icone="dialog-information", substituir=None):
    """Mostra uma notificação e devolve o id dela (pra substituir depois)."""
    if not shutil.which("notify-send"):
        return None
    cmd = ["notify-send", "-a", "krocket", "-i", icone, "-p"]
    if substituir:
        cmd += ["-r", str(substituir)]
    r = subprocess.run(cmd + [titulo, texto], capture_output=True, text=True)
    return r.stdout.strip() or None


def copiar(texto, aviso=True):
    try:
        klipper = dbus.SessionBus().get_object("org.kde.klipper", "/klipper")
        klipper.setClipboardContents(texto, dbus_interface="org.kde.klipper.klipper")
        if aviso:
            avisar("Copiado", texto, "edit-copy")
    except dbus.DBusException:
        if shutil.which("wl-copy"):
            subprocess.run(["wl-copy", texto])


def abrir_krunner(texto, plugin=None):
    """Abre o KRunner já com um texto digitado (usado pelo kr). Com plugin, mostra só os
    resultados dele, sem apps e arquivos misturados."""
    def abrir():
        try:
            app = dbus.SessionBus().get_object("org.kde.krunner", "/App")
            if plugin:
                app.querySingleRunner(plugin, texto, dbus_interface="org.kde.krunner.App")
            else:
                app.query(texto, dbus_interface="org.kde.krunner.App")
        except dbus.DBusException:
            pass
        return False
    GLib.timeout_add(250, abrir)  # espera o KRunner fechar depois do Enter


def resultado(id_, texto, icone, relevancia, nota, subtexto="", acoes=None, urls=None, multilinha=False):
    props = {"subtext": subtexto}
    if acoes is not None:
        props["actions"] = dbus.Array(acoes, signature="s")
    if urls:
        props["urls"] = dbus.Array(urls, signature="s")
    if multilinha:
        props["multiline"] = True
    return (id_, texto, icone, relevancia, float(nota), dbus.Dictionary(props, signature="sv"))


def tempo_atras(segundos):
    for limite, nome in ((86400, "d"), (3600, "h"), (60, "min")):
        if segundos >= limite:
            return f"{int(segundos // limite)}{nome}"
    return "agora"


class Plugin(dbus.service.Object):
    """Base: cuida da palavra-chave e da conversa com o KRunner. Cada plugin implementa
    buscar(termo, com_palavra) e rodar(id, acao)."""
    CAMINHO = ""
    ID = ""  # X-KDE-PluginInfo-Name do .desktop
    ACOES = []
    SEM_PALAVRA = False  # True se o plugin também responde sem a palavra-chave
    DESCRICAO = ""
    ICONE = "system-run"

    def __init__(self, bus, cfg):
        super().__init__(bus, self.CAMINHO)
        self.cfg = cfg

    def separar(self, query):
        q = query.strip()
        palavra = self.cfg["palavra"]
        if q == palavra or q.startswith(palavra + " "):
            return True, q[len(palavra):].strip()
        return False, q

    @dbus.service.method(IFACE, in_signature="s", out_signature="a(sssida{sv})")
    def Match(self, query):
        com_palavra, termo = self.separar(query)
        if not com_palavra and not self.SEM_PALAVRA:
            return []
        try:
            return self.buscar(termo, com_palavra)
        except Exception as e:  # um erro num plugin não pode derrubar o serviço inteiro
            print(f"krocket {self.CAMINHO}: {e!r}", file=sys.stderr)
            return []

    @dbus.service.method(IFACE, out_signature="a(sss)")
    def Actions(self):
        return self.ACOES

    @dbus.service.method(IFACE, in_signature="ss")
    def Run(self, id_, acao):
        if id_:
            self.rodar(id_, acao)

    @dbus.service.method(IFACE)
    def Teardown(self):
        self.fechou()

    def fechou(self):
        pass


# ---------------------------------------------------------------- repositórios

def ler_git(pasta):
    """Branch e URL web do remote, lidos direto da pasta .git (sem chamar o git)."""
    git = pasta / ".git"
    if git.is_file():  # worktree ou submódulo: "gitdir: <caminho>"
        m = re.match(r"gitdir:\s*(.+)", git.read_text(errors="ignore").strip())
        if not m:
            return None, None
        git = (pasta / m.group(1)).resolve()
    branch = None
    try:
        head = (git / "HEAD").read_text().strip()
        branch = head.removeprefix("ref: refs/heads/") if head.startswith("ref:") else head[:8]
    except OSError:
        pass
    web = None
    try:
        conf = (git / "config").read_text(errors="ignore")
        m = re.search(r'\[remote "origin"\][^\[]*?url\s*=\s*(\S+)', conf) or re.search(r"url\s*=\s*(\S+)", conf)
        if m:
            web = url_web(m.group(1))
    except OSError:
        pass
    return branch, web


def url_web(remote):
    remote = remote.removesuffix(".git")
    m = re.match(r"(?:ssh://)?git@([^:/]+)[:/](.+)", remote)
    if m:
        return f"https://{m.group(1)}/{m.group(2)}"
    if remote.startswith(("http://", "https://")):
        return re.sub(r"//[^@/]+@", "//", remote)  # tira usuário/token da URL
    return None


def achar_repos(pastas, profundidade, ignorar):
    achados = []

    def andar(d, nivel):
        if (d / ".git").exists():
            achados.append(d)
            return
        if nivel >= profundidade:
            return
        try:
            filhos = [e for e in os.scandir(d) if e.is_dir(follow_symlinks=False)]
        except OSError:
            return
        for e in filhos:
            if e.name.startswith(".") or e.name in ignorar:
                continue
            andar(Path(e.path), nivel + 1)

    for p in pastas:
        p = Path(p).expanduser()
        if p.is_dir():
            andar(p, 0)
    return achados


def recentes_vscode():
    """{pasta: quando foi aberta} a partir do workspaceStorage do VS Code."""
    recentes = {}
    try:
        entradas = list(os.scandir(VSCODE_STORAGE))
    except OSError:
        return recentes
    for e in entradas:
        try:
            ws = json.loads(Path(e.path, "workspace.json").read_text())
            uri = ws.get("folder")
            if not uri or not uri.startswith("file://"):
                continue
            pasta = unquote(urlparse(uri).path)
            if os.path.isdir(pasta):
                recentes[pasta] = max(recentes.get(pasta, 0), e.stat().st_mtime)
        except (OSError, ValueError):
            continue
    return recentes


def git_rodar(caminho, *args, timeout=60):
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0")  # nunca fica esperando senha
    return subprocess.run(["git", "-C", caminho, *args], capture_output=True, text=True, env=env, timeout=timeout)


def git_em_segundo_plano(caminho, verbo, depois=None):
    """git pull/push com notificação no fim."""
    def rodar():
        nome = Path(caminho).name
        args = ["pull", "--ff-only"] if verbo == "pull" else [verbo]
        try:
            r = git_rodar(caminho, *args)
            ok, saida = r.returncode == 0, (r.stdout + r.stderr).strip()
        except subprocess.TimeoutExpired:
            ok, saida = False, "demorou demais"
        if ok:
            avisar(f"{nome}: git {verbo} ok", saida.splitlines()[-1] if saida else "", "vcs-normal")
        else:
            avisar(f"{nome}: git {verbo} falhou", saida[-400:], "dialog-error")
        if depois:
            depois()
    threading.Thread(target=rodar, daemon=True).start()


class Repos(Plugin):
    CAMINHO = "/repos"
    ID = "krocket-repos"
    SEM_PALAVRA = True
    DESCRICAO = "Abre um repositório no VS Code"
    ICONE = "folder-git"
    ACOES = [
        ("terminal", "Abrir no terminal", "utilities-terminal"),
        ("claude", "Abrir o Claude Code aqui", "dialog-messages"),
        ("pasta", "Abrir no gerenciador de arquivos", "system-file-manager"),
        ("web", "Abrir o remote no navegador", "internet-web-browser"),
        ("pull", "git pull", "vcs-pull"),
        ("copiar", "Copiar o caminho", "edit-copy"),
    ]

    def __init__(self, bus, cfg):
        super().__init__(bus, cfg)
        self.itens = {}  # caminho -> dict
        self.escaneado = 0
        self.trava = threading.Lock()
        self.escanear()

    def escanear(self):
        c = self.cfg
        itens = {}
        recentes = recentes_vscode() if c["recentes_vscode"] else {}
        for pasta in achar_repos(c["pastas"], c["profundidade"], set(c["ignorar"])):
            itens[str(pasta)] = {"git": True}
        for pasta in recentes:
            itens.setdefault(pasta, {"git": os.path.exists(os.path.join(pasta, ".git"))})
        for caminho, item in itens.items():
            p = Path(caminho)
            item["nome"] = p.name
            item["busca_nome"] = normalizar(p.name)
            item["busca_caminho"] = normalizar(til(caminho))
            item["recente"] = recentes.get(caminho, 0)
            item["branch"], item["web"] = ler_git(p) if item["git"] else (None, None)
        with self.trava:
            self.itens = itens
            self.escaneado = time.time()

    def talvez_reescanear(self):
        if time.time() - self.escaneado > self.cfg["reescanear"]:
            self.escaneado = time.time()  # evita disparar duas vezes
            threading.Thread(target=self.escanear, daemon=True).start()

    def lista(self):
        self.talvez_reescanear()
        with self.trava:
            return dict(self.itens)

    @staticmethod
    def pontuar(termo, item):
        nome, caminho = item["busca_nome"], item["busca_caminho"]
        if nome == termo:
            return 1.0
        if nome.startswith(termo):
            return 0.9
        if termo in nome:
            return 0.8
        palavras = termo.split()
        if len(palavras) > 1 and all(w in caminho for w in palavras):
            return 0.7
        if len(termo) >= 3:
            it = iter(nome)
            if all(c in it for c in termo):  # letras na ordem: "pkcs" -> PokeCroc_Server
                return 0.5
        return 0

    def buscar(self, termo, com_palavra):
        termo = normalizar(termo)
        if not com_palavra and len(termo) < self.cfg["minimo"]:
            return []
        agora = time.time()
        achados = []
        for caminho, item in self.lista().items():
            if termo:
                nota = self.pontuar(termo, item)
                if nota == 0 or (not com_palavra and nota < 0.8):
                    continue
            else:
                nota = 0.5
            if item["recente"]:  # aberto no VS Code nos últimos 30 dias sobe um pouco
                nota += 0.1 * max(0.0, 1 - (agora - item["recente"]) / (30 * 86400))
            achados.append((nota, caminho, item))
        achados.sort(key=lambda a: (-a[0], -a[2]["recente"], a[2]["nome"]))
        saida = []
        for nota, caminho, item in achados[:10]:
            extra = []
            if item["branch"]:
                extra.append(item["branch"])
            if not item["git"]:
                extra.append("recente do VS Code")
            sub = til(caminho) + ("  ·  " + "  ·  ".join(extra) if extra else "")
            acoes = ["terminal", "claude", "pasta"] + (["web", "pull"] if item["web"] else []) + ["copiar"]
            icone = "folder-git" if item["git"] else "vscode"
            saida.append(resultado(caminho, item["nome"], icone, ALTA if com_palavra else MEDIA,
                                   min(nota, 1.0), sub, acoes, ["file://" + caminho]))
        return saida

    def rodar(self, caminho, acao):
        abrir_repo(self.cfg, caminho, acao, self.itens.get(caminho, {}).get("web"))


def abrir_repo(c, caminho, acao, web=None):
    """Ações de repositório, compartilhadas entre o vs e o gs."""
    if acao == "terminal":
        no_terminal(c["terminal"], [], cwd=caminho)
    elif acao == "claude":
        no_terminal(c["terminal"], shlex.split(c["claude"]), cwd=caminho)
    elif acao == "pasta":
        lancar(shlex.split(c["arquivos"]) + [caminho])
    elif acao == "web":
        if web:
            lancar(["xdg-open", web])
    elif acao in ("pull", "push"):
        git_em_segundo_plano(caminho, acao)
    elif acao == "copiar":
        copiar(caminho)
    else:
        lancar(shlex.split(c["editor"]) + [caminho], cwd=caminho)


# ---------------------------------------------------------------- git status

def ler_status(caminho):
    """Resumo do `git status`: alterados, novos, à frente/atrás do upstream (do último fetch)."""
    try:
        r = git_rodar(caminho, "status", "--porcelain=v2", "--branch", timeout=5)
    except subprocess.TimeoutExpired:
        return None
    if r.returncode != 0:
        return None
    st = {"branch": None, "upstream": False, "frente": 0, "atras": 0, "alterados": 0, "novos": 0}
    for linha in r.stdout.splitlines():
        if linha.startswith("# branch.head "):
            st["branch"] = linha.split(" ", 2)[2]
        elif linha.startswith("# branch.upstream "):
            st["upstream"] = True
        elif linha.startswith("# branch.ab "):
            m = re.match(r"# branch\.ab \+(\d+) -(\d+)", linha)
            if m:
                st["frente"], st["atras"] = int(m.group(1)), int(m.group(2))
        elif linha.startswith("?"):
            st["novos"] += 1
        elif linha and not linha.startswith("#"):
            st["alterados"] += 1
    st["pendente"] = bool(st["alterados"] or st["novos"] or st["frente"] or st["atras"])
    return st


class Git(Plugin):
    CAMINHO = "/git"
    ID = "krocket-git"
    DESCRICAO = "Repositórios com alterações, commits sem push ou atrasados"
    ICONE = "vcs-locally-modified"
    ACOES = [
        ("terminal", "Abrir no terminal", "utilities-terminal"),
        ("claude", "Abrir o Claude Code aqui", "dialog-messages"),
        ("pull", "git pull", "vcs-pull"),
        ("push", "git push", "vcs-push"),
        ("web", "Abrir o remote no navegador", "internet-web-browser"),
    ]

    def __init__(self, bus, cfg, repos):
        super().__init__(bus, cfg)
        self.repos = repos
        self.status, self.quando = {}, 0
        self.trava = threading.Lock()

    def atualizar(self):
        if time.time() - self.quando < 15:
            return self.status
        with self.trava:
            if time.time() - self.quando < 15:
                return self.status
            caminhos = [c for c, i in self.repos.lista().items() if i["git"]]
            with ThreadPoolExecutor(8) as ex:
                self.status = dict(zip(caminhos, ex.map(ler_status, caminhos)))
            self.quando = time.time()
        return self.status

    def buscar(self, termo, com_palavra):
        termo = normalizar(termo)
        itens = self.repos.lista()
        saida = []
        for caminho, st in self.atualizar().items():
            if not st or caminho not in itens:
                continue
            nome = itens[caminho]["nome"]
            if termo and termo not in normalizar(nome):
                continue
            if not termo and not st["pendente"]:
                continue
            partes = [st["branch"] or "?"]
            if st["alterados"]:
                partes.append(f"{st['alterados']} alterado{'s' if st['alterados'] > 1 else ''}")
            if st["novos"]:
                partes.append(f"{st['novos']} novo{'s' if st['novos'] > 1 else ''}")
            if st["frente"]:
                partes.append(f"↑{st['frente']} sem push")
            if st["atras"]:
                partes.append(f"↓{st['atras']} pra puxar")
            if not st["pendente"]:
                partes.append("em dia")
            if st["upstream"] is False:
                partes.append("sem upstream")
            if st["atras"]:
                icone = "vcs-update-required"
            elif st["alterados"] or st["novos"]:
                icone = "vcs-locally-modified"
            elif st["frente"]:
                icone = "vcs-push"
            else:
                icone = "vcs-normal"
            acoes = ["terminal", "claude"]
            if st["upstream"]:
                acoes += ["pull", "push"]
            if itens[caminho]["web"]:
                acoes.append("web")
            nota = 0.9 if st["pendente"] else 0.5
            saida.append(resultado(caminho, nome, icone, ALTA, nota, "  ·  ".join(partes), acoes))
        if not saida and not termo:
            saida.append(resultado("", "Tudo em dia", "vcs-normal", ALTA, 1.0,
                                   f"{len(self.status)} repositórios sem alteração nem commit pendente"))
        if not termo:
            saida.append(resultado("@fetch", "Buscar atualizações de todos (git fetch)", "vcs-pull", ALTA, 0.1,
                                   "Atualiza o ↓ de cada repositório, sem mexer nos seus arquivos"))
        saida.sort(key=lambda r: -r[4])
        return saida

    def rodar(self, caminho, acao):
        if caminho == "@fetch":
            threading.Thread(target=self.buscar_todos, daemon=True).start()
            return
        self.quando = 0
        abrir_repo(self.repos.cfg, caminho, acao, self.repos.itens.get(caminho, {}).get("web"))

    def buscar_todos(self):
        id_ = avisar("git fetch", "Buscando atualizações de todos os repositórios...", "vcs-pull")
        caminhos = [c for c, st in self.atualizar().items() if st and st["upstream"]]

        def fetch(c):
            try:
                return git_rodar(c, "fetch", "--quiet", timeout=60).returncode == 0
            except subprocess.TimeoutExpired:
                return False
        with ThreadPoolExecutor(6) as ex:
            ok = list(ex.map(fetch, caminhos))
        self.quando = 0
        atrasados = [Path(c).name for c, st in self.atualizar().items() if st and st["atras"]]
        texto = f"{sum(ok)} de {len(ok)} atualizados."
        texto += f" Pra puxar: {', '.join(atrasados)}" if atrasados else " Nada novo pra puxar."
        avisar("git fetch terminou", texto, "vcs-normal", substituir=id_)


