class IA(Plugin):
    ACAO_PADRAO = "Perguntar"
    CAMINHO = "/ia"
    ID = "krocket-ia"
    DESCRICAO = "Pergunta pra IA local (Ollama)"
    ICONE = "dialog-messages"
    ACOES = [
        ("webui", "Continuar no Open WebUI", "internet-web-browser"),
        ("copiar", "Copiar a resposta", "edit-copy"),
    ]

    def __init__(self, bus, cfg):
        super().__init__(bus, cfg)
        self.respostas = {}  # pergunta -> resposta (até o serviço reiniciar)
        self.pensando = set()

    PALAVRAS_LIBERAR = ("liberar", "descarregar", "parar", "stop")

    def api(self, rota, corpo=None, timeout=180):
        req = urllib.request.Request(self.cfg["url"].rstrip("/") + rota,
                                     json.dumps(corpo).encode() if corpo is not None else None,
                                     {"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r)

    def carregados(self):
        """[(modelo, GB)] do que está ocupando RAM/VRAM agora."""
        try:
            return [(m["name"], m.get("size", 0) / 2**30) for m in self.api("/api/ps", timeout=1).get("models", [])]
        except (urllib.error.URLError, TimeoutError, ValueError, OSError):
            return []

    def item_liberar(self, nota):
        modelos = self.carregados()
        if modelos:
            sub = "  ·  ".join(f"{n} ({gb:.0f} GB)" for n, gb in modelos) + "  ·  tira da memória agora"
            return resultado("@liberar", "Liberar a memória da IA", "edit-clear", ALTA, nota, sub, [])
        return resultado("", "A IA não está ocupando memória", "edit-clear", ALTA, nota,
                         "Nenhum modelo carregado no Ollama", [])

    def liberar(self):
        modelos = self.carregados()
        try:
            for nome, _ in modelos:
                self.api("/api/generate", {"model": nome, "keep_alive": 0}, timeout=30)
        except (urllib.error.URLError, TimeoutError, ValueError, OSError) as e:
            avisar("Não deu pra liberar a IA", str(e), "dialog-error")
            return
        livre = sum(gb for _, gb in modelos)
        avisar("Memória da IA liberada", f"{', '.join(n for n, _ in modelos)}  ·  {livre:.0f} GB livres"
               if modelos else "Nada estava carregado", "edit-clear")

    def buscar(self, termo, com_palavra):
        modelo = self.cfg["modelo"]
        if not termo:
            return [resultado("", f"Pergunte algo pro {modelo}", "dialog-messages", ALTA, 1.0,
                              "ia <pergunta>  ·  Enter manda, a resposta chega numa notificação"),
                    self.item_liberar(0.9)]
        n = normalizar(termo)
        if len(n) >= 3 and any(p.startswith(n) for p in self.PALAVRAS_LIBERAR):
            return [self.item_liberar(1.0)]
        if termo in self.respostas:
            resp = self.respostas[termo]
            return [resultado(termo, resp, "dialog-messages", ALTA, 1.0,
                              f"Resposta do {modelo}  ·  Enter copia", ["copiar", "webui"], multilinha=True)]
        if termo in self.pensando:
            return [resultado("", "Pensando...", "chronometer", ALTA, 1.0,
                              f"{modelo}: a resposta chega numa notificação")]
        return [resultado(termo, f"Perguntar: {termo}", "dialog-messages", ALTA, 1.0,
                          f"{modelo}  ·  Enter manda, a resposta chega numa notificação", ["webui"])]

    def perguntar(self, pergunta, notificar=True):
        """Pergunta pro Ollama e devolve a resposta (None se falhou)."""
        c = self.cfg
        self.pensando.add(pergunta)
        id_ = avisar(f"Perguntando pro {c['modelo']}...", pergunta, "chronometer") if notificar else None
        try:
            resposta = self.api("/api/chat", {
                "model": c["modelo"], "stream": False, "think": False, "keep_alive": c["manter_carregado"],
                "messages": [{"role": "system", "content": c["instrucoes"]}, {"role": "user", "content": pergunta}],
            })["message"]["content"].strip()
        except (urllib.error.URLError, TimeoutError, ValueError, KeyError, OSError) as e:
            avisar("IA local não respondeu", f"{e}. O Ollama está rodando? (sv ollama)", "dialog-error", substituir=id_)
            return None
        finally:
            self.pensando.discard(pergunta)
        self.respostas[pergunta] = resposta
        if c["copiar_resposta"]:
            copiar(resposta, aviso=False)
        if notificar:
            rodape = "\n\n(copiado)" if c["copiar_resposta"] else ""
            avisar(pergunta, resposta + rodape, "dialog-messages", substituir=id_)
        return resposta

    def rodar(self, pergunta, acao):
        if pergunta == "@liberar":
            threading.Thread(target=self.liberar, daemon=True).start()
        elif acao == "webui":
