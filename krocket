def atalhos_web():
    """Atalhos de busca na web instalados pelo krocket (Keys e Name dos .desktop)."""
    atalhos = []
    for f in sorted((DADOS / "kf6/searchproviders").glob("*.desktop")):
        campos = dict(re.findall(r"^(Keys|Name)=(.*)$", f.read_text(errors="ignore"), re.M))
        if "Keys" in campos:
            atalhos.append((campos["Keys"].split(","), campos.get("Name", f.stem)))
    return atalhos


EXTRAS_KDE = [  # coisas do próprio KRunner que pouca gente conhece
    ("=", "=2^10*3", "Calculadora", "accessories-calculator"),
    ("10 usd em brl", "10 usd em brl", "Converte moedas e unidades (km, kg, °C...)", "accessories-calculator"),
    ("kill", "kill ", "Mata um processo pelo nome", "process-stop"),
    ("define", "define ", "Dicionário", "accessories-dictionary"),
    ("gg:", "gg:", "Pesquisa no Google (yt: YouTube, wp: Wikipedia, gh: GitHub)", "internet-web-browser"),
    ("?", "?", "Ajuda do KRunner: todos os plugins instalados", "help-about"),
]


class Ajuda(Plugin):
    CAMINHO = "/ajuda"
    ID = "krocket-ajuda"
    DESCRICAO = "Lista os comandos do krocket"
    ICONE = "help-about"

    def __init__(self, bus, cfg, plugins):
        super().__init__(bus, cfg)
        self.plugins = plugins

    def itens(self):
        for p in self.plugins:
            palavra = p.cfg["palavra"]
            yield palavra, palavra + " ", p.DESCRICAO, p.ICONE, "krocket", p.ID
        for chaves, nome in atalhos_web():
            yield (" / ".join(f"{k}:" for k in chaves), f"{chaves[-1]}:", f"Pesquisa no {nome}",
                   "internet-web-browser", "busca na web", None)
        for nome, texto, desc, icone in EXTRAS_KDE:
            yield nome, texto, desc, icone, "do KDE", None

    def buscar(self, termo, com_palavra):
        termo = normalizar(termo)
        saida = []
        self.alvos = {}
        for i, (nome, texto, desc, icone, origem, plugin) in enumerate(self.itens()):
            self.alvos[texto] = plugin
            if termo and termo not in normalizar(f"{nome} {desc} {origem}"):
                continue
            saida.append(resultado(texto, f"{nome}  —  {desc}", icone, ALTA, 1 - i * 0.01,
                                   f"{origem}  ·  Enter já abre o KRunner com \"{texto.strip()}\""))
        return saida

    def rodar(self, texto, acao):
        abrir_krunner(texto, getattr(self, "alvos", {}).get(texto))


def montar(bus, cfg):
    repos = Repos(bus, cfg["repos"])
    plugins = [
        repos,
        Git(bus, cfg["git"], repos),
        Docker(bus, cfg["docker"]),
        Servicos(bus, cfg["servicos"]),
        Tailscale(bus, cfg["tailscale"]),
        IA(bus, cfg["ia"]),
    ]
    return plugins + [Ajuda(bus, cfg["ajuda"], plugins)]


def main():
    if sys.argv[1:2] == ["reiniciar"]:
        # Mata o serviço (o D-Bus sobe de novo na próxima busca) e reinicia o KRunner pra ele
        # reler os plugins. Só fechar o KRunner não serve: o Alt+Espaço não consegue abrir ele de volta.
        subprocess.run(["pkill", "-f", "python3? .*krocket$"], check=False)
        subprocess.run(["systemctl", "--user", "restart", "plasma-krunner"], capture_output=True, check=False)
        return
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    cfg = carregar_config()
    if "--testar" in sys.argv:  # krocket --testar "vs poke": mostra o que o KRunner receberia
        q = " ".join(a for a in sys.argv[1:] if a != "--testar")
        for plugin in montar(bus, cfg):
            for r in plugin.Match(q):
                print(f"[{type(plugin).__name__}] {r[1][:50]:<50} {r[4]:.2f}  {r[5]['subtext']}")
        return
    nome = dbus.service.BusName(SERVICO, bus, do_not_queue=True)  # noqa: F841 (segura o nome no bus)
    montar(bus, cfg)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
