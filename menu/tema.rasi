/*
 * krocket: tema do menu (rofi)
 * Fica em ~/.config/krocket/tema.rasi. Mude as cores e tamanhos aqui embaixo
 * e abra o menu de novo pra ver (não precisa reiniciar nada).
 * A cor da palavra-chave (vs, gs...) fica no config.toml: [menu] cor_palavra.
 */

* {
    fundo:        #19191eff;   /* fundo da janela (os 2 últimos dígitos são a opacidade: ff = sólido) */
    fundo-caixa:  #232328;     /* fundo da barra de busca e do rodapé */
    texto:        #dcdce1;
    apagado:      #8c8c91;     /* rodapé, dica da busca */
    destaque:     #e92f17;     /* borda, prompt, letras que bateram com a busca */
    selecionado:  #2e2e35;     /* fundo da linha selecionada */
    escurecer:    #0000004d;   /* a tela atrás do menu; 00000000 = sem escurecer */

    font:             "Noto Sans 10";
    background-color: transparent;
    text-color:       @texto;
}

/* A janela ocupa a tela toda (transparente) e a caixa fica dentro dela: assim um
   clique fora da caixa cai no rofi e fecha o menu, em qualquer desktop. */
window {
    fullscreen:       true;
    background-color: @escurecer;
    /* 0 = colado no topo, como o KRunner; 16em = metade da largura da caixa (32em de largura) */
    padding:          0 calc( 50% - 16em ) 0;
}

mainbox {
    expand:           false;
    spacing:          6px;
    children:         [ inputbar, listview, message ];
    background-color: @fundo;
    border:           0 1px 1px 1px;   /* colada no topo: sem borda em cima */
    border-color:     @destaque;
    border-radius:    0 0 10px 10px;
    padding:          8px;
}

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          6px 10px;
    background-color: @fundo-caixa;
    border-radius:    6px;
}

prompt {
    text-color: @destaque;
    font:       "Noto Sans Bold 10";
}

entry {
    placeholder:       "vs, pa, ja, ar, gs, dk, sv, ia... ou kr pra ajuda";
    placeholder-color: @apagado;
    cursor:            text;
}

listview {
    lines:        12;          /* quantas linhas aparecem de uma vez */
    fixed-height: true;        /* altura fixa: com a lista chegando aos poucos, o rofi não consegue encolher a caixa */
    spacing:      0;
    scrollbar:    false;
}

element {
    padding:       4px 10px;
    spacing:       10px;
    border-radius: 6px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @selecionado;
    border:           0 0 0 3px;   /* faixa vermelha à esquerda da linha selecionada */
    border-color:     @destaque;
}

element-icon {
    size: 1.2em;
}

element-text {
    vertical-align: 0.5;
    highlight:      bold #feb9b6;
}

message {
    padding:          4px 10px;
    background-color: @fundo-caixa;
    border-radius:    6px;
}

textbox {
    text-color: @apagado;
    font:       "Noto Sans 8";
}

/* janela "Perguntando pro gemma..." e mensagens de erro */
error-message {
    expand:           false;
    padding:          20px;
    background-color: @fundo;
    border:           2px;
    border-color:     @destaque;
    border-radius:    14px;
}

error-message textbox {
    text-color: @texto;
    font:       "Noto Sans 10";
}
